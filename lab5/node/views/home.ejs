<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
    <%- include('partials/navbar') %>
    <main class="container py-3">
        <header class="intro">
            <h1>Solar System</h1>
        </header>
        <% if (error) { %>
            <div class="error" role="alert">
                <p><%= error %></p>
                <a href="/">Try again</a>
            </div>
        <% } else { %>
            <section class="row g-4" aria-label="Four random space images">
                <% for (let i = 0; i < images.length; i++) { %>
                    <div class="col-md-6">
                        <figure>
                            <img class="space-image" src="<%= images[i].webformatURL %>" alt="<%= images[i].tags || 'Space photograph' %>">
                            <figcaption>
                                <a href="<%= images[i].pageURL %>" target="_blank" rel="noopener noreferrer">Photo by <%= images[i].user || 'Pixabay contributor' %> on Pixabay</a>
                            </figcaption>
                        </figure>
                    </div>
                <% } %>
            </section>
        <% } %>
    </main>
    <%- include('partials/footer') %>
</body>
</html>
